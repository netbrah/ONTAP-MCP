# NetApp ONTAP Key Manager MCP Server Configuration

# Server Port
PORT=3000

# ONTAP Cluster Configuration
# This should be a JSON array of cluster configurations.
# Each cluster needs: name, cluster_ip, username, password
# Optional fields: description, verify_ssl (default: true)
#
# Example with one cluster:
# ONTAP_CLUSTERS='[{"name":"prod-cluster","cluster_ip":"10.1.1.100","username":"admin","password":"MySecurePassword123","description":"Production Cluster","verify_ssl":true}]'
#
# Example with multiple clusters:
ONTAP_CLUSTERS='[{"name":"cluster1","cluster_ip":"10.1.1.100","username":"admin","password":"password123","description":"Production Cluster 1"},{"name":"cluster2","cluster_ip":"10.1.1.200","username":"admin","password":"password456","description":"Production Cluster 2"}]'

# SSL Verification (optional, defaults to true for security)
# Set verify_ssl to false in the cluster config above if you need to disable SSL verification for a specific cluster
