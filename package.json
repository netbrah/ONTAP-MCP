{
  "name": "ontap-keymanager-mcp",
  "version": "2.0.0",
  "description": "NetApp ONTAP Key Manager MCP Server - FastMCP-based HTTP SSE server for key management operations",
  "main": "build/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/server.js",
    "dev": "tsc && node build/server.js",
    "docker:build": "docker build -t ontap-keymanager-mcp .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "mcp",
    "netapp",
    "ontap",
    "keymanager",
    "fastmcp",
    "sse",
    "security"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "fastmcp": "^3.31.0",
    "zod": "^3.25.76"
  }
}
