# NetApp ONTAP Key Manager MCP Server Configuration

# Copy this file to .env and update with your ONTAP cluster details

# ONTAP Cluster Configuration (REQUIRED)
ONTAP_CLUSTER_IP=192.168.1.100
ONTAP_USERNAME=admin
ONTAP_PASSWORD=your-password-here

# Server Configuration (OPTIONAL)
PORT=3000
NODE_ENV=production

# Usage:
# 1. Copy this file to .env
# 2. Update with your actual cluster management IP and credentials
# 3. Run with Docker Compose: docker-compose up -d
# 4. Or run locally: npm run build && node build/server.js

# Example Docker Compose Usage:
#   docker-compose up -d
#   
# Access:
#   HTTP SSE endpoint: http://localhost:3000/sse
#   Health check:      http://localhost:3000/health

# Key Manager Tools Available:
# - list_key_managers, get_key_manager
# - create_external_key_manager, create_onboard_key_manager
# - update_key_manager_passphrase, sync_key_manager, delete_key_manager
# - list_key_servers, add_key_server, delete_key_server
# - list_keys, create_auth_key, restore_keys
